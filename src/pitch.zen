squared_distance = std.math.vector
// Monophonic pitch estimate for 1024 mono samples at 16 kHz. Caller owns
// 321 doubles of scratch. YIN difference/normalization rejects weak periodicity.
Ptr, Alloc, AllocError, null_ptr = std.mem
sqrt = std.math
estimate* = (samples: Ptr<f64>, scratch: Ptr<f64>) f64 {
    energy ::= 0.0;
    mean   ::= 0.0;
    Range(0, 1024).loop((i) { mean = mean + samples.read(i); });
    mean = mean / 1024.0;
    Range(0, 1024).loop((i) { v = samples.read(i) - mean; energy = energy + v * v; });
    (energy / 1024.0 < 0.000025).match({
        true  => 0.0,
        false => {
            total ::= 0.0;
            Range(1, 321).loop((lag) {
                difference = squared_distance(
                    samples,
                    samples.offset(lag),
                    704
                );
                total      = total + difference;
                l          = lag.to_u64().to_i32().match({Ok(v) => v.to_f64(), None => 0.0});
                scratch.write(
                    lag,
                    (total > 0.0).match({true => difference * l / total, false => 1.0})
                );
            });
            selected ::= 0;
            Range(33, 320).loop((lag) {
                (selected == 0 && scratch.read(lag) < 0.15 && scratch.read(lag) <= scratch.read(lag - 1) && scratch.read(lag) < scratch.read(lag + 1)).then(() { selected = lag; });
            });
            (selected > 0).match({
                false => 0.0,
                true  => {
                    left        = scratch.read(selected - 1);
                    center      = scratch.read(selected);
                    right       = scratch.read(selected + 1);
                    denominator = left - 2.0 * center + right;
                    offset      = (denominator > 0.000000001).match({true => 0.5 * (left - right) / denominator, false => 0.0});
                    lag         = selected.to_f64();
                    16000.0 / (lag + offset)
                },
            })
        },
    })
}
Summary* = { mean*: f64, low*: f64, high*: f64, count*: usize }
Window* = {
    values: Ptr<f64>, times: Ptr<f64>, next :: usize, count :: usize,
    create* = (a: Alloc) Res<Window, AllocError> {
        Ok(Window(
            values: a.realloc<f64>(null_ptr<f64>(), 32).try(),
            times: a.realloc<f64>(null_ptr<f64>(), 32).try(),
            next: 0,
            count: 0
        ))
    }
    reset* = (self :: @Self) { self.next = 0; self.count = 0; }
    // Sample at most 10 Hz; timestamps in seconds. Unvoiced estimates are zero.
    record* = (self :: @Self, now: f64, hz: f64) {
        self.values.write(self.next, hz); self.times.write(self.next, now);
        self.next = (self.next + 1) % 32;
        (self.count < 32).then(() { self.count = self.count + 1; });
    }
    summary* = (self: @Self, now: f64) Summary {
        sum ::= 0.0; low ::= 1000.0; high ::= 0.0; count ::= 0; n ::= 0.0;
        Range(0, self.count).loop((i) {
            value = self.values.read(i);
            (self.times.read(i) > now - 3.0 && value > 0.0).then(() {
                sum = sum + value; count = count + 1; n = n + 1.0;
                (value < low).then(() { low = value; });
                (value > high).then(() { high = value; });
            });
        });
        (count > 0).match({true => Summary(mean: sum / n, low: low, high: high, count: count), false => Summary(mean: 0.0, low: 0.0, high: 0.0, count: 0)})
    }
}
