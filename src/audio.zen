// Caller owns all storage. Samples, real, imaginary and magnitude buffers must
// not overlap. Scratch buffers have count elements; magnitudes has count/2+1.
Ptr = std.mem
String, str_at = std.text

cos, sin, sqrt, log10 = std.math

number = (value: usize) f64 {
    value.to_u64().to_i32().match({ Ok(v) => v.to_f64(), None => 0.0 })
}

// Periodic Hann window, normalized to peak sinusoid amplitude. DC and Nyquist
// are not doubled. Samples are borrowed and never modified. No allocations.
analyze* = (
    samples    : Ptr<f64>,
    real       : Ptr<f64>,
    imaginary  : Ptr<f64>,
    magnitudes : Ptr<f64>,
    count      : usize
) bool {
    valid ::= count >= 4 && count <= 1048576;
    size  ::= count;
    loop(size > 1 && valid, (h) {
        (size % 2 != 0).then(() { valid = false; });
        size = size / 2;
    });
    (valid && !samples.is_null() && !real.is_null() &&
     !imaginary.is_null() && !magnitudes.is_null()).match({
        false => false,
        true  => {
            scale = number(count);
            Range(0, count).loop((i) {
                window = 0.5 - 0.5 * cos(6.283185307179586 * number(i) / scale);
                real.write(i, samples.read(i) * window);
                imaginary.write(i, 0.0);
            });
            reversed ::= 0;
            Range(1, count).loop((i) {
                bit ::= count / 2;
                loop(reversed >= bit && bit > 0, (h) {
                    reversed = reversed - bit;
                    bit      = bit / 2;
                });
                reversed = reversed + bit;
                (i < reversed).then(() {
                    saved = real.read(i);
                    real.write(i, real.read(reversed));
                    real.write(reversed, saved);
                });
            });
            width ::= 2;
            loop(width <= count, (h) {
                half           = width / 2;
                angle          = -6.283185307179586 / number(width);
                step_real      = cos(angle);
                step_imaginary = sin(angle);
                start ::= 0;
                loop(start < count, (block) {
                    wr ::= 1.0;
                    wi ::= 0.0;
                    Range(0, half).loop((offset) {
                        even = start + offset;
                        odd  = even + half;
                        tr   = wr * real.read(odd) - wi * imaginary.read(odd);
                        ti   = wr * imaginary.read(odd) + wi * real.read(odd);
                        er   = real.read(even);
                        ei   = imaginary.read(even);
                        real.write(even, er + tr);
                        imaginary.write(even, ei + ti);
                        real.write(odd, er - tr);
                        imaginary.write(odd, ei - ti);
                        next_wr = wr * step_real - wi * step_imaginary;
                        wi      = wr * step_imaginary + wi * step_real;
                        wr      = next_wr;
                    });
                    start = start + width;
                });
                width = width * 2;
            });
            Range(0, count / 2 + 1).loop((i) {
                re     = real.read(i);
                im     = imaginary.read(i);
                factor = (i == 0 || i == count / 2).match({true => 2.0, false => 4.0});
                magnitudes.write(i, sqrt(re * re + im * im) * factor / scale);
            });
            true
        },
    })
}

// Equal-width frequency bands excluding DC. Each output is the maximum
// normalized amplitude of its bins, not power or decibels. Input and output
// buffers must not overlap; output has count elements.
bands* = (
    magnitudes : Ptr<f64>,
    bins       : usize,
    output     : Ptr<f64>,
    count      : usize
) bool {
    (bins < 2 || bins > 524289 || count == 0 || count > bins - 1 ||
     magnitudes.is_null() || output.is_null()).match({
        true  => false,
        false => {
            Range(0, count).loop((band) {
                start = 1 + band * (bins - 1) / count;
                end   = 1 + (band + 1) * (bins - 1) / count;
                peak ::= 0.0;
                Range(start, end).loop((i) {
                    value = magnitudes.read(i);
                    (value > peak).then(() { peak = value; });
                });
                output.write(band, peak);
            });
            true
        },
    })
}

// Speech display: equal mel intervals from 80 Hz through 4 kHz. Magnitudes
// are analyze's peak amplitudes; output is clamped -65..-15 dBFS mapped to 0..1.
// Caller supplies distinct input/output buffers. No allocation or native calls
// outside std.math. Empty frequency buckets remain zero.
voice_bands* = (
    magnitudes : Ptr<f64>,
    bins       : usize,
    rate       : u32,
    output     : Ptr<f64>,
    count      : usize
) bool {
    (bins < 3 || bins > 524289 || count == 0 || count > 128 ||
     count > bins - 1 || rate < 8000 || rate > 192000 ||
     magnitudes.is_null() || output.is_null()).match({
        true  => false,
        false => {
            Range(0, count).loop((band) { output.write(band, 0.0); });
            low        = log10(1.0 + 80.0 / 700.0);
            span       = log10(1.0 + 4000.0 / 700.0) - low;
            resolution = number(rate.to_usize()) / number(2 * (bins - 1));
            band: usize ::= 0;
            Range(1, bins).loop((i) {
                frequency = number(i) * resolution;
                (frequency >= 80.0 && frequency <= 4000.0).then(() {
                    position = (log10(1.0 + frequency / 700.0) - low) / span;
                    loop(band + 1 < count && position >= number(band + 1) / number(count), (h) {
                        band = band + 1;
                    });
                    magnitude = magnitudes.read(i);
                    (magnitude > output.read(band)).then(() { output.write(band, magnitude); });
                });
            });
            Range(0, count).loop((i) {
                peak  = output.read(i);
                level = (peak <= 0.000562341325190349).match({
                    true  => 0.0,
                    false => (peak >= 0.1778279410038923).match({
                        true  => 1.0,
                        false => (20.0 * log10(peak) + 65.0) / 50.0,
                    }),
                });
                output.write(i, level);
            });
            true
        },
    })
}

unit = (value: f64) f64 {
    (value >= 0.0).match({
        false => 0.0,
        true  => (value > 1.0).match({true => 1.0, false => value}),
    })
}

// Initialize state to zero once. Attack 35 ms, release 180 ms; backward-Euler
// smoothing follows elapsed seconds. Gaps >=1 second snap to the current target.
// Invalid elapsed/count/pointers leave state untouched. Buffers may be identical
// but must not partially overlap. No allocation; targets/state normalize to 0..1.
smooth_levels* = (
    target  : Ptr<f64>,
    state   : Ptr<f64>,
    count   : usize,
    elapsed : f64
) bool {
    (count == 0 || count > 128 || target.is_null() || state.is_null() ||
     !(elapsed >= 0.0) || elapsed > f64.MAX).match({
        true  => false,
        false => {
            Range(0, count).loop((i) {
                current = unit(state.read(i));
                desired = unit(target.read(i));
                tau     = (desired > current).match({true => 0.035, false => 0.180});
                alpha   = (elapsed >= 1.0).match({true => 1.0, false => elapsed / (tau + elapsed)});
                state.write(i, unit(current + (desired - current) * alpha));
            });
            true
        },
    })
}

WavError* = InvalidRate | InvalidSize | MissingSamples | UnsupportedByteOrder
WavEncodeError* = WavError | AllocError

little = (out :: String, value: usize, bytes: usize) Res<(), AllocError> {
    rest ::= value;
    Range(0, bytes).loop((i) {
        (rest % 256).to_u8().match({Ok(byte) => out.add(byte), None => Ok(())}).try();
        rest = rest / 256;
    });
    Ok(())
}

// Mono IEEE float WAV (format 3), including fmt extension and fact sample count.
// Supported native targets are little-endian; reject other byte order explicitly.
encode_wav* = (a: Alloc, samples: Ptr<f32>, count: usize, rate: u32)
              Res<String, WavEncodeError> {
    (rate > 0 && rate <= 1073741823).ensure(WavError.InvalidRate).try();
    (count <= 1073741811).ensure(WavError.InvalidSize).try();
    (count == 0 || !samples.is_null()).ensure(WavError.MissingSamples).try();
    probe = a.create<u32>().try();
    @scope.defer(() { a.free(probe); });
    probe.write(0, 1);
    (probe.to<u8>().read(0) == 1).ensure(WavError.UnsupportedByteOrder).try();
    out ::= a.String().try();
    out.add("RIFF").try();
    little(out, 50 + count * 4, 4).try();
    out.add("WAVEfmt ").try();
    little(out, 18, 4).try();
    little(out, 3, 2).try();
    little(out, 1, 2).try();
    little(out, rate.to_usize(), 4).try();
    little(out, rate.to_usize() * 4, 4).try();
    little(out, 4, 2).try();
    little(out, 32, 2).try();
    little(out, 0, 2).try();
    out.add("fact").try();
    little(out, 4, 4).try();
    little(out, count, 4).try();
    out.add("data").try();
    little(out, count * 4, 4).try();
    (count > 0).then(
        () { out.add(str_at(samples.to<u8>(), count * 4)).try(); }
    );
    Ok(out)
}
