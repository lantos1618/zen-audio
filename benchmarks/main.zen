analyze, voice_bands, smooth_levels = audio
sin = std.math
BenchClock = c.bind("QuartzCore/QuartzCore.h", { CACurrentMediaTime* = () f64 })

main = (env: Env) Res<i32, AllocError> {
    arena ::= env.mem.alloc();
    samples    = arena.realloc<f64>(null_ptr<f64>(), 1024).try();
    real       = arena.realloc<f64>(null_ptr<f64>(), 1024).try();
    imaginary  = arena.realloc<f64>(null_ptr<f64>(), 1024).try();
    magnitudes = arena.realloc<f64>(null_ptr<f64>(), 513).try();
    targets    = arena.realloc<f64>(null_ptr<f64>(), 32).try();
    levels     = arena.realloc<f64>(null_ptr<f64>(), 32).try();
    phase ::= 0.0;
    Range(0, 1024).loop((i) {
        samples.write(i, 0.1 * sin(phase) + 0.03 * sin(phase * 3.0));
        phase = phase + 6.283185307179586 * 1000.0 / 16000.0;
    });
    Range(0, 32).loop((i) { levels.write(i, 0.0); });
    valid         ::= true;
    checksum: f64 ::= 0.0;
    // First batch warms all buffers and code; it is not reported.
    Range(0, 32).loop((batch) {
        start = BenchClock.CACurrentMediaTime();
        Range(0, 1000).loop((iteration) {
            valid    = analyze(
                samples,
                real,
                imaginary,
                magnitudes,
                1024
            ) && valid;
            valid    = voice_bands(
                magnitudes,
                513,
                16000,
                targets,
                32
            ) && valid;
            valid    = smooth_levels(targets, levels, 32, 1.0 / 60.0) && valid;
            checksum = checksum + levels.read(iteration % 32);
        });
        elapsed = BenchClock.CACurrentMediaTime() - start;
        (batch > 0).then(() { println("batch_us {}", elapsed * 1000.0); });
    });
    println("checksum {}", checksum);
    println("valid {}", valid);
    Ok((valid && checksum > 0.0).match({true => 0, false => 1}))
}
