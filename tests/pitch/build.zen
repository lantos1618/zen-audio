Builder, BuildError = std.build
build = (b :: Builder) Res<(), BuildError> {
    audio = b.lib(
        "audio",
        {src: Path("../../src/audio.zen"), libs: ["m"], paths: []}
    ).try();
    b.exe(
        "pitch",
        {src: Path("main.zen"), deps: [audio], out: Ok(Path("../../build/pitch-test"))}
    ).try();
    Ok(())
}
